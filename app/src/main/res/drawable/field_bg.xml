<?xml version="1.0" encoding="utf-8"?>
<!-- Thick bright border when focused, so the remote's position is always obvious. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/panel" /><corners android:radius="10dp" />
            <stroke android:width="4dp" android:color="@color/accent" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/panel" /><corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#3A4350" /></shape>
    </item>
</selector>
